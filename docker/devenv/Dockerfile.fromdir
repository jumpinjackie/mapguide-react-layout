# Developer environment image for MapGuide Open Source on Ubuntu 22.04.
# This variant builds from a locally-provided MapGuide installer instead of
# downloading it from a URL.
#
# The installer is expected to be staged in the build context at
# .installer/installer.run. mapguide-devenv.sh does this automatically when
# invoked with --installer-dir; the source path can be overridden via the
# INSTALLER_SRC build arg.
FROM ubuntu:22.04

ENV MG_PATH=/usr/local/mapguideopensource-4.0.0
ENV DEBIAN_FRONTEND=noninteractive

ARG INSTALLER_SRC=.installer/installer.run

COPY ${INSTALLER_SRC} /tmp/mapguide-install.run

RUN apt-get update \
 && apt-get install -y --no-install-recommends ca-certificates software-properties-common \
 && add-apt-repository -y multiverse \
 && apt-get update \
 && echo "ttf-mscorefonts-installer msttcorefonts/accepted-mscorefonts-eula select true" | debconf-set-selections \
 && apt-get install -y --no-install-recommends fontconfig ttf-mscorefonts-installer \
 && chmod +x /tmp/mapguide-install.run \
 && /tmp/mapguide-install.run -- --headless --with-sdf --with-shp --with-sqlite --with-gdal --with-ogr --with-rdbms --with-wfs --with-wms --no-service-install --no-mgserver-start \
 && rm -f /tmp/mapguide-install.run \
 && apt-get clean \
 && rm -rf /var/lib/apt/lists/* /var/cache/apt/archives/* /tmp/* /var/tmp/* /root/.cache/*

COPY entrypoint.sh /usr/local/bin/entrypoint.sh
RUN chmod +x /usr/local/bin/entrypoint.sh

EXPOSE 8008

ENTRYPOINT ["/usr/local/bin/entrypoint.sh"]
